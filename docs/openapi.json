  "info": {
    "title": "Field Sales & Beat Execution API",
    "description": "Generated from the Zod schemas in packages/shared via nestjs-zod + @nestjs/swagger (Architecture §9). Request bodies are documented from the createZodDto-derived DTOs each controller already uses for validation; per-route response shapes are not yet annotated.",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "companyCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "LogoutDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "companyCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": [
          "username"
        ]
      },
      "VerifyOtpDto": {
        "type": "object",
        "properties": {
          "companyCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$"
          }
        },
        "required": [
          "username",
          "code"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "resetToken": {
            "type": "string",
            "minLength": 1
          },
          "newPassword": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "confirmPassword": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "resetToken",
          "newPassword",
          "confirmPassword"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "newPassword": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "confirmPassword": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "currentPassword",
          "newPassword",
          "confirmPassword"
        ]
      },
      "CreateCompanyDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "place": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "contactEmail": {
            "type": "string",
            "format": "email",
            "maxLength": 200
          },
          "contactPhone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "default": "Asia/Kolkata"
          },
          "admin": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "email": {
                "type": "string",
                "format": "email",
                "maxLength": 200
              },
              "username": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "temporaryPassword": {
                "type": "string",
                "minLength": 8,
                "maxLength": 128
              },
              "mobile": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              }
            },
            "required": [
              "name",
              "username",
              "temporaryPassword"
            ]
          }
        },
        "required": [
          "code",
          "name",
          "admin"
        ]
      },
      "UpdateCompanyDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "place": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "contactEmail": {
            "type": "string",
            "format": "email",
            "maxLength": 200
          },
          "contactPhone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SUSPENDED"
            ]
          }
        }
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 200
          },
          "role": {
            "type": "string",
            "enum": [
              "COMPANY_ADMIN",
              "MANAGER",
              "MARKETING_EXECUTIVE",
              "EMPLOYEE"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ],
            "default": "ACTIVE"
          },
          "photoFileId": {
            "type": "string",
            "minLength": 1
          },
          "monthlySalary": {
            "type": "string",
            "pattern": "^\\d{1,10}(\\.\\d{1,2})?$"
          },
          "halfDayRate": {
            "type": "string",
            "pattern": "^\\d{1,10}(\\.\\d{1,2})?$"
          },
          "rateEffectiveFrom": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "temporaryPassword": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "mobile": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        },
        "required": [
          "name",
          "role"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 200
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ]
          },
          "photoFileId": {
            "type": "string",
            "minLength": 1
          },
          "monthlySalary": {
            "type": "string",
            "pattern": "^\\d{1,10}(\\.\\d{1,2})?$"
          },
          "halfDayRate": {
            "type": "string",
            "pattern": "^\\d{1,10}(\\.\\d{1,2})?$"
          },
          "rateEffectiveFrom": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      },
      "SalaryRateDto": {
        "type": "object",
        "properties": {
          "halfDayRate": {
            "type": "string",
            "pattern": "^\\d{1,10}(\\.\\d{1,2})?$"
          },
          "rateEffectiveFrom": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "halfDayRate",
          "rateEffectiveFrom"
        ]
      }
    }
  }
}
