# Copy to .env and fill in real values for local development.
# See packages/shared/src/env.ts for validation rules.

# Runtime connection: a dedicated non-superuser, non-table-owner role (e.g.
# "app_user", created by migration 20261002110942_rls_user_fileobject).
# Postgres RLS policies are bypassed entirely for superusers and (without
# FORCE) for table owners, so the API must NOT connect as "postgres" for
# RLS on "users"/"file_objects" to actually be enforced (Architecture §5 /
# WU-03 design note).
DATABASE_URL="postgresql://app_user:change-me@localhost:5432/field_sales?schema=public"

# Migrations. Prisma has NO auto-migrate — nothing in app startup applies
# one — so `prisma migrate deploy` has to be run by something.
#
# LOCALLY, pass the privileged connection inline and leave this unset:
#
#   cd apps/api
#   DATABASE_URL="postgresql://postgres:<pwd>@localhost:5432/field_sales" \
#     pnpm exec prisma migrate deploy
#
# IN A DEPLOYED ENVIRONMENT, set MIGRATE_DATABASE_URL and the container
# entrypoint (apps/api/docker-entrypoint.sh) applies migrations once, before
# the server starts. Unset, it skips them — for deployments that migrate
# from CI instead.
#
# It is a SEPARATE, privileged connection and the application process never
# reads it: `env.ts` does not validate it and Prisma Client never sees it.
# That separation is the point — app_user cannot CREATE TABLE by design,
# because Postgres bypasses row-level security for superusers and the
# running app must never be one.
#MIGRATE_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/field_sales"

JWT_ACCESS_SECRET="change-me-to-a-random-32-plus-character-secret"
JWT_REFRESH_SECRET="change-me-to-a-different-32-plus-character-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="60d"

FILE_URL_SECRET="change-me-to-a-random-32-plus-character-secret"
PASSWORD_RESET_SECRET="change-me-to-a-different-32-plus-character-secret"
# ── Photo storage ──────────────────────────────────────────────────────
#
# Two drivers, one interface. Set STORAGE_DRIVER and fill in only that
# driver's variables — the other driver's are not required and are ignored.
# Validation is conditional, so a wrong combination fails at boot naming the
# missing variable rather than at the first photo upload.
STORAGE_DRIVER="volume"          # "volume" | "s3"

# --- STORAGE_DRIVER=volume (the default) -------------------------------
# A disk mounted into the container. No credentials exist for one: the app
# writes to it with ordinary filesystem calls. Must match the Mount Path
# configured on the volume.
RAILWAY_VOLUME_MOUNT_PATH="./.data/volume"

# --- STORAGE_DRIVER=s3 -------------------------------------------------
# Any S3-compatible endpoint: AWS, Railway object storage, MinIO, R2.
# Required when STORAGE_DRIVER=s3; leave blank/absent otherwise.
#
# S3_BUCKET            the bucket name
# S3_ACCESS_KEY_ID     the access key
# S3_SECRET_ACCESS_KEY the secret key
# S3_REGION            defaults to us-east-1, which most non-AWS providers
#                      accept as a placeholder
# S3_ENDPOINT          OMIT for AWS. Required for everyone else.
# S3_FORCE_PATH_STYLE  "true" for providers serving host/bucket/key rather
#                      than bucket.host/key — i.e. almost everything but AWS
#
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_REGION="auto"
# S3_ENDPOINT=""
# S3_FORCE_PATH_STYLE="true"
#
# NOTE: photos are stored under the key photos/<companyId>/<yyyy>/<mm>/...
# in whichever backend is active. Those slashes are part of a flat S3 key,
# not real folders — there is nothing to pre-create in the bucket, and
# avatars and shop photos share one prefix. What tells them apart is
# FileObject.kind (USER_AVATAR / SHOP_PHOTO), not their location.

SEED_SYSTEM_ADMIN_USERNAME="sysadmin"
SEED_SYSTEM_ADMIN_PASSWORD="change-me-please-12345"

LOG_LEVEL="info"

PORT=3000
