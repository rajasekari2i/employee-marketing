# Copy to .env and fill in real values for local development.
# See packages/shared/src/env.ts for validation rules.

# Runtime connection: a dedicated non-superuser, non-table-owner role (e.g.
# "app_user", created by migration 20261002110942_rls_user_fileobject).
# Postgres RLS policies are bypassed entirely for superusers and (without
# FORCE) for table owners, so the API must NOT connect as "postgres" for
# RLS on "users"/"file_objects" to actually be enforced (Architecture §5 /
# WU-03 design note).
DATABASE_URL="postgresql://app_user:change-me@localhost:5432/field_sales?schema=public"

# DATABASE_URL above is the ONLY database variable this application needs.
#
# Migrations are the exception, and they are not run by the app. `prisma
# migrate deploy` needs CREATE TABLE/ROLE/POLICY privileges that app_user
# deliberately does not have, so pass the privileged connection inline for
# that one command rather than storing a second credential here:
#
#   cd apps/api
#   DATABASE_URL="postgresql://postgres:<pwd>@localhost:5432/field_sales" \
#     pnpm exec prisma migrate deploy
#
# Keeping it out of this file is the point: a superuser URL sitting in the
# app's environment is one copy-paste away from becoming the app's own
# connection, and that failure is silent (see the warning above).

JWT_ACCESS_SECRET="change-me-to-a-random-32-plus-character-secret"
JWT_REFRESH_SECRET="change-me-to-a-different-32-plus-character-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="60d"

FILE_URL_SECRET="change-me-to-a-random-32-plus-character-secret"
PASSWORD_RESET_SECRET="change-me-to-a-different-32-plus-character-secret"
RAILWAY_VOLUME_MOUNT_PATH="./.data/volume"

SEED_SYSTEM_ADMIN_USERNAME="sysadmin"
SEED_SYSTEM_ADMIN_PASSWORD="change-me-please-12345"

LOG_LEVEL="info"

PORT=3000
