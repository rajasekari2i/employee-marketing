// Prisma schema for the Field Sales & Beat Execution API.
// Models are added starting in work unit WU-02 (specs/001-company-user-auth) —
// this file currently only declares the datasource and client generator.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (WU-02 / T007)
// ---------------------------------------------------------------------------

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum RoleKey {
  SYSTEM_ADMIN
  COMPANY_ADMIN
  MANAGER
  MARKETING_EXECUTIVE
  EMPLOYEE
}

// 002-shops-crud added SHOP_PHOTO (data-model.md Enums).
enum PhotoKind {
  USER_AVATAR
  SHOP_PHOTO
}

// 002-shops-crud (data-model.md Enums). Deliberately missing the full
// architecture model's PENDING/GPS (LocationSource/LocationStatus) and
// REJECTED (PinChangeStatus) variants — none are reachable from this
// feature; the executive's first-visit pin-capture flow (a later slice)
// can add them additively when it needs them.
enum LocationSource {
  MAP_SEARCH
  MANUAL_DRAG
  // 006-visit-outcomes: how an executive's first-visit pin capture obtains
  // the point. 002-shops-crud's comment above named this flow as the one
  // that would add it.
  GPS
}

enum LocationStatus {
  NONE
  APPROVED
  // 006-visit-outcomes: where an executive-captured pin sits when the
  // company does not auto-approve (FR-033). An outcome cannot be recorded
  // at a shop in this state.
  PENDING_VERIFICATION
}

enum PinChangeStatus {
  REQUESTED
  DECIDED
}

// 005-executive-dashboard (data-model.md "Enums"). Two different rules are at
// work in the three enums below, deliberately:
//
// BeatDayStatus OMITS the architecture's AUTO_CLOSED. Nothing in this slice
// can set it — auto-closing a forgotten beat needs a scheduled-job runtime
// that does not exist — and nothing reads it. Added additively by the slice
// that implements auto-close, the same posture 002-shops-crud took when it
// declared only the LocationSource values it could reach.
//
// StopStatus and StopSource DO declare their full sets even though only
// PENDING and PLAN have writers today, because this slice's own code *reads*
// the others: the list ordering puts REVISIT between to-do and completed
// (FR-011), the running card counts Revisit and Extra (FR-017), and board 1.3
// draws a chip for each. Declaring them is what lets that logic be written
// once, correctly, now.
enum BeatDayStatus {
  RUNNING
  ENDED
}

enum StopStatus {
  PENDING
  COMPLETED
  SKIPPED
  REVISIT
}

enum StopSource {
  PLAN
  EXEC_EXTRA
  MANAGER_EXTRA
}

// 006-visit-outcomes (data-model.md).
enum VisitOutcome {
  ORDER
  NO_ORDER
}

// Omits the architecture's decided states (accepted / revisit-requested) —
// nothing here writes or reads them; the manager review slice adds them.
enum ReviewStatus {
  NOT_REQUIRED
  PENDING_REVIEW
}

// 010-manager-app: taken verbatim from 03-ARCHITECTURE.md:269-271.
enum AttendanceSession {
  MORNING
  EVENING
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  HOLIDAY
  WEEKLY_OFF
}

// Derived by the server from the company's session start times and delay
// thresholds — NEVER accepted from a client (FR-035). It looks like an
// observation a device could make; it is the company's settings applied to
// an arrival time, exactly as `Visit.isExceedRange` is the company's radius
// applied to a position.
enum LatenessFlag {
  ON_TIME
  DELAY_1H
  DELAY_2H
}

enum DeliveryStatus {
  TO_DELIVER
  DELIVERED
}

// Declares its full set even though MOCK_LOCATION_SUSPECTED has NO PRODUCER:
// the installed geolocation library does not expose Android's
// isFromMockProvider() signal (research.md §5), so a mocked position is
// currently indistinguishable from a real one. Declared rather than omitted
// because the flag-evaluation code reads the whole set and the manager
// review slice renders it — the gap is recorded, not hidden. Closing it
// needs a small native call or a library swap; neither changes this schema.
enum VisitFlag {
  LOW_ACCURACY
  STALE_LOCATION
  MOCK_LOCATION_SUSPECTED
  OFFLINE_SUBMISSION
  EXCEED_RANGE
}

// ---------------------------------------------------------------------------
// Company & settings (T008, T009)
// ---------------------------------------------------------------------------

model Company {
  id           String        @id @default(uuid())
  code         String        @unique
  name         String
  place        String?
  contactEmail String?       @map("contact_email")
  contactPhone String?       @map("contact_phone")
  timezone     String        @default("Asia/Kolkata")
  status       CompanyStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  settings CompanySettings?
  users    User[]

  @@map("companies")
}

model CompanySettings {
  companyId String @id @map("company_id")

  defaultRadiusMeters   Int      @default(5) @map("default_radius_meters")
  maxAccuracyMeters     Int      @default(20) @map("max_accuracy_meters")
  maxLocationAgeSeconds Int      @default(120) @map("max_location_age_seconds")
  morningSessionStart   String   @default("09:00") @map("morning_session_start")
  eveningSessionStart   String   @default("14:00") @map("evening_session_start")
  delay1hMinutes        Int      @default(60) @map("delay_1h_minutes")
  delay2hMinutes        Int      @default(120) @map("delay_2h_minutes")
  autoApproveExecPins   Boolean  @default(false) @map("auto_approve_exec_pins")
  beatNotStartedAt      String   @default("10:30") @map("beat_not_started_at")
  beatNotEndedAt        String   @default("20:00") @map("beat_not_ended_at")
  beatAutoCloseAt       String   @default("23:00") @map("beat_auto_close_at")
  offlineMaxAgeHours    Int      @default(24) @map("offline_max_age_hours")
  payableUnitByStatus   Json     @default("{\"PRESENT\":1,\"HOLIDAY\":1,\"WEEKLY_OFF\":1,\"LEAVE\":0,\"ABSENT\":0}") @map("payable_unit_by_status")
  notificationsEnabled  Json     @default("{}") @map("notifications_enabled")
  updatedAt             DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_settings")
}

// ---------------------------------------------------------------------------
// Role (T010)
// ---------------------------------------------------------------------------

// Application-wide: exactly one row per `key`, shared by every company —
// not a per-company table (see roles.seed.ts).
model Role {
  id          String   @id @default(uuid())
  key         RoleKey  @unique
  label       String
  permissions String[]
  isSystem    Boolean  @default(true) @map("is_system")

  users User[]

  @@map("roles")
}

// ---------------------------------------------------------------------------
// User & related (T011, T012)
// ---------------------------------------------------------------------------

model User {
  id String @id @default(uuid())

  // null only for SYSTEM_ADMIN (FR-004)
  companyId String? @map("company_id")
  roleId    String  @map("role_id")

  name         String
  // Read-only to the user themself after creation (FR-021) — not enforceable in Prisma.
  email        String?
  // Unique within companyId, case-insensitive (FR-006). Nullable because
  // required-only-when-role != EMPLOYEE is enforced in service code, not the DB (FR-017).
  username     String?
  passwordHash String?    @map("password_hash")
  mobile       String?
  photoId      String?    @unique @map("photo_id")
  status       UserStatus @default(ACTIVE)

  monthlySalary Decimal?  @map("monthly_salary") @db.Decimal(12, 2)
  tokenVersion  Int       @default(0) @map("token_version")
  lastLoginAt   DateTime? @map("last_login_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company           Company?          @relation(fields: [companyId], references: [id])
  role              Role              @relation(fields: [roleId], references: [id])
  photo             FileObject?       @relation(fields: [photoId], references: [id])
  salaryRates       UserSalaryRate[]
  refreshTokens     RefreshToken[]
  otpChallenges     OtpChallenge[]
  // 003-beat-plans-crud: the reverse side of BeatPlan.executiveId.
  assignedBeatPlans BeatPlan[]
  // 005-executive-dashboard: the reverse side of DailyAssignment.executiveId.
  assignments       DailyAssignment[]
  // 006-visit-outcomes: the reverse side of Visit.executiveId.
  visits            Visit[]
  // 010-manager-app: the reverse side of Attendance.userId.
  attendance        Attendance[]

  @@unique([companyId, username])
  @@index([companyId, status])
  @@map("users")
}

model UserSalaryRate {
  id        String @id @default(uuid())
  companyId String @map("company_id")
  userId    String @map("user_id")

  halfDayRate   Decimal   @map("half_day_rate") @db.Decimal(12, 2)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([companyId, userId, effectiveFrom])
  @@map("user_salary_rates")
}

// ---------------------------------------------------------------------------
// Auth support (T013, T014)
// ---------------------------------------------------------------------------

model RefreshToken {
  id        String  @id @default(uuid())
  userId    String  @map("user_id")
  familyId  String  @map("family_id")
  tokenHash String  @unique @map("token_hash")
  deviceId  String? @map("device_id")
  userAgent String? @map("user_agent")

  usedAt    DateTime? @map("used_at")
  revokedAt DateTime? @map("revoked_at")
  expiresAt DateTime  @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model OtpChallenge {
  id       String @id @default(uuid())
  userId   String @map("user_id")
  codeHash String @map("code_hash")
  purpose  String @default("PASSWORD_RESET")
  attempts Int    @default(0)

  consumedAt DateTime? @map("consumed_at")
  expiresAt  DateTime  @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("otp_challenges")
}

// ---------------------------------------------------------------------------
// Files (avatar-only subset) (T015)
// ---------------------------------------------------------------------------

model FileObject {
  id        String    @id @default(uuid())
  companyId String?   @map("company_id")
  kind      PhotoKind

  storageKey String  @unique @map("storage_key")
  mimeType   String  @map("mime_type")
  byteSize   Int     @map("byte_size")
  width      Int?
  height     Int?
  sha256     String
  thumbKey   String? @map("thumb_key")

  uploadedBy String   @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User?
  // 002-shops-crud: the reverse side of ShopPhoto.fileId.
  shopPhotos ShopPhoto[]

  @@index([companyId, kind])
  @@map("file_objects")
}

// ---------------------------------------------------------------------------
// Idempotency & audit (T016, T017)
// ---------------------------------------------------------------------------

model IdempotencyKey {
  id          String   @id @default(uuid())
  key         String   @unique
  companyId   String?  @map("company_id")
  userId      String?  @map("user_id")
  endpoint    String
  requestHash String   @map("request_hash")
  statusCode  Int?     @map("status_code")
  response    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("idempotency_keys")
}

model AuditEvent {
  id          String   @id @default(uuid())
  companyId   String?  @map("company_id")
  actorUserId String   @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  before      Json?
  after       Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Shops (002-shops-crud)
// ---------------------------------------------------------------------------

// data-model.md's Shop entity. Deliberately omits the full architecture
// model's beatPlanShops/stops relations, createdByRole/needsReview, and
// formattedAddress/placeId — none are reachable from this feature
// (research.md §1: BeatPlan doesn't exist yet; §2: no Places result-caching
// in this pass).
model Shop {
  id        String @id @default(uuid())
  companyId String @map("company_id")

  shopCode String @map("shop_code")

  name      String
  ownerName String? @map("owner_name")
  phone     String?

  addressLine1 String? @map("address_line1")
  addressLine2 String? @map("address_line2")
  city         String?
  state        String?
  postalCode   String? @map("postal_code")

  latitude       Decimal?        @db.Decimal(9, 6)
  longitude      Decimal?        @db.Decimal(9, 6)
  locationSource LocationSource? @map("location_source")
  locationStatus LocationStatus  @default(NONE) @map("location_status")

  // 006-visit-outcomes (FR-032): a pin captured by an executive records the
  // accuracy of the reading it came from. 002-shops-crud had no need for it
  // — an admin setting a pin by map search has no device accuracy — but an
  // executive's GPS capture does, and a manager reviewing a pin needs to
  // know how good the fix was.
  locationAccuracyMeters Int? @map("location_accuracy_meters")

  locationCapturedAt DateTime? @map("location_captured_at")
  locationCapturedBy String?   @map("location_captured_by")
  locationVerifiedAt DateTime? @map("location_verified_at")
  locationVerifiedBy String?   @map("location_verified_by")

  // Reserved for the future nearby-shops query (Architecture §4's
  // bounding-box/geohash indexes) — not user-facing in this feature.
  geohash String?

  // null = use the company-wide default (FR-007).
  verificationRadiusMeters Int? @map("verification_radius_meters")

  isActive Boolean @default(true) @map("is_active")

  photos          ShopPhoto[]
  pinChanges      ShopPinChange[]
  // 003-beat-plans-crud: the reverse side of BeatPlanShop.shopId.
  beatPlanShops   BeatPlanShop[]
  // 005-executive-dashboard: the reverse side of AssignmentStop.shopId.
  assignmentStops AssignmentStop[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  visits    Visit[]
  orders    Order[]

  @@unique([companyId, shopCode])
  @@index([companyId, isActive])
  @@index([companyId, locationStatus])
  @@map("shops")
}

model ShopPhoto {
  id        String @id @default(uuid())
  companyId String @map("company_id")

  shopId String @map("shop_id")
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  fileId String     @map("file_id")
  file   FileObject @relation(fields: [fileId], references: [id])

  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([companyId, shopId, sortOrder])
  @@map("shop_photos")
}

// Append-only coordinate-correction audit (BUS-17; research.md §3). A row
// is only ever written when an edit changes the coordinates of a shop
// whose locationStatus is already APPROVED — a shop's first pin (NONE ->
// APPROVED) is a direct capture with no row here.
model ShopPinChange {
  id        String @id @default(uuid())
  companyId String @map("company_id")

  shopId String @map("shop_id")
  shop   Shop   @relation(fields: [shopId], references: [id])

  status PinChangeStatus @default(REQUESTED)

  fromLatitude  Decimal?       @map("from_latitude") @db.Decimal(9, 6)
  fromLongitude Decimal?       @map("from_longitude") @db.Decimal(9, 6)
  toLatitude    Decimal        @map("to_latitude") @db.Decimal(9, 6)
  toLongitude   Decimal        @map("to_longitude") @db.Decimal(9, 6)
  source        LocationSource

  requestedBy String    @map("requested_by")
  requestedAt DateTime  @default(now()) @map("requested_at")
  decidedBy   String?   @map("decided_by")
  decidedAt   DateTime? @map("decided_at")

  @@index([companyId, shopId, status])
  @@map("shop_pin_changes")
}

// ---------------------------------------------------------------------------
// Beat plans (003-beat-plans-crud)
// ---------------------------------------------------------------------------

// data-model.md's BeatPlan entity. Deliberately omits the full architecture
// model's `assignments DailyAssignment[]` relation — `DailyAssignment`
// doesn't exist yet (that's 008-beat-day); added additively whenever that
// slice is built, the same way this slice is now adding Shop.beatPlanShops
// and User.assignedBeatPlans onto models 002-shops-crud/001-company-user-auth
// already shipped.
model BeatPlan {
  id        String @id @default(uuid())
  companyId String @map("company_id")

  code String
  name String

  executiveId String? @map("executive_id")
  executive   User?   @relation(fields: [executiveId], references: [id])

  workingDays Int[] @map("working_days")

  isActive Boolean @default(true) @map("is_active")

  shops BeatPlanShop[]

  // 005-executive-dashboard: the reverse side of DailyAssignment.beatPlanId.
  assignments DailyAssignment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@index([companyId, executiveId])
  @@map("beat_plans")
}

// One shop's position within one beat plan's route — current-state data,
// not a history/audit entity (data-model.md's "Why no append-only
// treatment" note). Fully replaced on every save (research.md §1); sequence
// is always server-assigned from array position, never a client field.
model BeatPlanShop {
  id        String @id @default(uuid())
  companyId String @map("company_id")

  beatPlanId String   @map("beat_plan_id")
  beatPlan   BeatPlan @relation(fields: [beatPlanId], references: [id], onDelete: Cascade)

  shopId String @map("shop_id")
  shop   Shop   @relation(fields: [shopId], references: [id])

  sequence Int

  @@unique([beatPlanId, shopId])
  @@index([companyId, beatPlanId, sequence])
  @@map("beat_plan_shops")
}

// ---------------------------------------------------------------------------
// Masters: brands & no-order reasons (004-brands-reasons-crud)
// ---------------------------------------------------------------------------

// Company-scoped master; becomes the subject of an order line in
// 009-visits-and-orders. Deliberately missing the full architecture model's
// `orderLines OrderLine[]` relation — OrderLine doesn't exist yet; added
// additively by that slice, same posture 003-beat-plans-crud took with
// DailyAssignment.
//
// `label` uniqueness is enforced twice: @@unique([companyId, label]) below
// (exact), plus a hand-written functional unique index on
// (company_id, lower(label)) in this slice's migration, which is the one
// that actually satisfies FR-007's case-insensitive rule — Prisma's schema
// language cannot express a functional index (data-model.md).
model Brand {
  id        String @id @default(uuid())
  companyId String @map("company_id")

  label String

  // Server-derived from array position, never client-sent (research.md §1).
  // 0-based, same convention as BeatPlanShop.sequence; the row number the
  // design prints is the list position + 1, computed at render time.
  displayOrder Int @map("display_order")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 006-visit-outcomes: the relation 004-brands-reasons-crud deferred by name.
  orderLines OrderLine[]

  @@unique([companyId, label])
  @@index([companyId, isActive, displayOrder])
  @@map("brands")
}

// Company-scoped master; becomes the single-select reason on a no-order
// visit in 009-visits-and-orders. Deliberately missing that model's
// `visits Visit[]` relation for the same reason as Brand.orderLines above.
//
// Every company has exactly one row with isSystem = true — its "Other"
// reason — created with the company (companies.service.ts) and backfilled
// for pre-existing companies by this slice's migration, which also adds a
// partial unique index making a second system row impossible.
model ReasonMessage {
  id        String @id @default(uuid())
  companyId String @map("company_id")

  label String

  displayOrder Int @map("display_order")

  isActive Boolean @default(true) @map("is_active")

  // true only for the system "Other" row. A column rather than a hard-coded
  // label comparison so the field app keys off data, not a magic string
  // (data-model.md). Server-set, never client-sent.
  requiresText Boolean @default(false) @map("requires_text")

  // true only for the system "Other" row. Drives every FR-011 guard, and is
  // the first orderBy key so "Other" sorts last by construction rather than
  // by holding a large displayOrder a later insert could overtake.
  isSystem Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 006-visit-outcomes: the relation 004-brands-reasons-crud deferred by name.
  visits Visit[]

  @@unique([companyId, label])
  @@index([companyId, isActive, displayOrder])
  @@map("reason_messages")
}

// ---------------------------------------------------------------------------
// Daily assignment & beat day (005-executive-dashboard)
// ---------------------------------------------------------------------------

// One row per executive per business day. Holds BOTH the frozen route and the
// beat-day lifecycle, so "is the beat running?" is a single field on the row
// the screen has already loaded — no join, no second query (Architecture §9).
//
// `status` is null until the beat starts, which is what makes the three-state
// lifecycle (not started / RUNNING / ENDED) a single nullable column.
//
// The @@unique([companyId, businessDate, executiveId]) below is LOAD-BEARING,
// not tidiness: it is the entire concurrency guarantee behind creating the
// route on first open (research.md §1). Two devices, a double tap and a
// refresh storm all converge on one row because the database refuses the
// second insert, and the service treats that refusal as "re-read the winner".
model DailyAssignment {
  id        String @id @default(uuid())
  companyId String @map("company_id")

  // The company-LOCAL calendar date, from CompanyClock — never the device
  // clock (FR-005). @db.Date so it carries no time component that could be
  // shifted across timezones.
  businessDate DateTime @map("business_date") @db.Date

  executiveId String @map("executive_id")
  executive   User   @relation(fields: [executiveId], references: [id])

  beatPlanId String?   @map("beat_plan_id")
  beatPlan   BeatPlan? @relation(fields: [beatPlanId], references: [id])

  // Snapshot of the plan's name at creation (FR-007) — renaming the plan
  // later never rewrites a past day's card.
  beatPlanName String? @map("beat_plan_name")

  status BeatDayStatus?

  startedAt           DateTime? @map("started_at")
  startLatitude       Decimal?  @map("start_latitude") @db.Decimal(9, 6)
  startLongitude      Decimal?  @map("start_longitude") @db.Decimal(9, 6)
  startAccuracyMeters Int?      @map("start_accuracy_meters")

  endedAt           DateTime? @map("ended_at")
  endLatitude       Decimal?  @map("end_latitude") @db.Decimal(9, 6)
  endLongitude      Decimal?  @map("end_longitude") @db.Decimal(9, 6)
  endAccuracyMeters Int?      @map("end_accuracy_meters")

  stops AssignmentStop[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([companyId, businessDate, executiveId])
  @@index([companyId, businessDate])
  @@index([companyId, executiveId, businessDate])
  @@map("daily_assignments")
}

// One shop's place on one day's route — a frozen snapshot, not a live view of
// the beat plan. A later edit to the plan, the shop or company settings never
// alters a stop that already exists (FR-007).
//
// `effectiveRadiusMeters` is stored here but NEVER serialised to an executive
// (data-model.md "What never reaches the executive"): it is the threshold
// every range verdict is computed against, so sending it would let the device
// derive "am I inside the radius?" — the inference Constitution rule 6 exists
// to prevent. The server needs it when visit submission is built.
model AssignmentStop {
  id        String @id @default(uuid())
  companyId String @map("company_id")

  assignmentId String          @map("assignment_id")
  assignment   DailyAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  shopId String @map("shop_id")
  shop   Shop   @relation(fields: [shopId], references: [id])

  sequence Int
  source   StopSource @default(PLAN)
  status   StopStatus @default(PENDING)

  addedByUserId String?   @map("added_by_user_id")
  addedAt       DateTime? @map("added_at")

  // 010-manager-app: the reason a MANAGER gave for adding this stop
  // (FR-043). Slice 007's data model recorded this column as deliberately
  // omitted — "it is for manager-added extras, which are out of scope, so it
  // stays omitted" — so it arrives now WITH its writer, which is the
  // discipline this schema has followed throughout.
  //
  // Nullable because a planned stop and an executive's own extra have no
  // reason. Required in the service for MANAGER_EXTRA, which is where the
  // rule belongs: the column describes three kinds of stop and only one
  // needs it.
  addReason String? @map("add_reason")

  effectiveRadiusMeters Int @map("effective_radius_meters")

  // 006-visit-outcomes (research.md §4): the shop's approved coordinate,
  // FROZEN here so a visit is measured against the location in force when it
  // was RECORDED, not when it was received. Without this, an offline visit
  // synced days later would be re-measured against whatever pin a manager
  // had since approved. Populated at route creation, and again at pin
  // capture for a shop that started without one. Null = no approved pin yet,
  // so no outcome can be recorded at that stop.
  shopLatitude  Decimal? @map("shop_latitude") @db.Decimal(9, 6)
  shopLongitude Decimal? @map("shop_longitude") @db.Decimal(9, 6)

  // Deliberately tighter than the architecture's
  // @@unique([assignmentId, shopId, sequence]): that three-column form would
  // let the same shop appear twice on one day at two sequence numbers, which
  // contradicts BUS-08 ("at most one completed primary outcome per shop per
  // executive per day"). Two columns make the duplicate unrepresentable, and
  // match the @@unique([beatPlanId, shopId]) precedent on BeatPlanShop.
  visit Visit?

  @@unique([assignmentId, shopId])
  @@index([companyId, assignmentId, status])
  @@index([companyId, shopId])
  @@map("assignment_stops")
}

// ---------------------------------------------------------------------------
// Visits & orders (006-visit-outcomes)
// ---------------------------------------------------------------------------

// One completed interaction at one shop on one day. IMMUTABLE once written —
// there is no update or delete path anywhere in the API, which is how
// "a submitted visit cannot be edited" (FR-016) is enforced.
//
// Seven fields here are stored on every visit and NEVER selected by an
// executive-facing query (data-model.md): shopLatitude, shopLongitude,
// effectiveRadiusMeters, distanceMeters, isExceedRange, flags, reviewStatus.
// They exist for the manager review slice and the reports. The guarantee is
// the absence of these names from the executive endpoints' select lists — a
// field never loaded cannot leak through a later refactor.
model Visit {
  id        String @id @default(uuid())
  companyId String @map("company_id")

  assignmentId String         @map("assignment_id")
  stopId       String         @map("stop_id")
  stop         AssignmentStop @relation(fields: [stopId], references: [id])
  shopId       String         @map("shop_id")
  shop         Shop           @relation(fields: [shopId], references: [id])
  executiveId  String         @map("executive_id")
  executive    User           @relation(fields: [executiveId], references: [id])

  outcome     VisitOutcome
  sampleShown Boolean      @map("sample_shown")

  reasonId    String?        @map("reason_id")
  reason      ReasonMessage? @relation(fields: [reasonId], references: [id])
  // Snapshot — renaming a reason later never rewrites recorded history.
  reasonLabel String?        @map("reason_label")
  // Already on the log redaction list (CLAUDE.md rule 9).
  reasonText  String?        @map("reason_text")

  // The executive's own position, as the device reported it.
  capturedLatitude  Decimal  @map("captured_latitude") @db.Decimal(9, 6)
  capturedLongitude Decimal  @map("captured_longitude") @db.Decimal(9, 6)
  accuracyMeters    Int      @map("accuracy_meters")
  capturedAt        DateTime @map("captured_at")
  submittedAt       DateTime @map("submitted_at")
  // The SERVER's clock — the authoritative time. A wrong device clock can
  // never move when a visit is recorded as having happened.
  receivedAt        DateTime @default(now()) @map("received_at")

  // 008-my-visits (research.md §2): the business day this visit belongs to,
  // SNAPSHOTTED from the stop's DailyAssignment at submission and never
  // updated. It cannot drift from its source — a DailyAssignment is itself
  // an immutable snapshot (BUS-05).
  //
  // It exists so the executive's history can be ordered DAY-MAJOR
  // (businessDate, submittedAt, id). That is what makes "one block per day,
  // even across a page boundary" (FR-011) a property of the query instead of
  // a hope: ordering by submittedAt alone would let a phone with a wrong
  // clock interleave two days and split a group. With this column a bad
  // device clock can misplace a row WITHIN its day and nothing more.
  //
  // Never client-supplied — absent from submitVisitSchema, which is
  // .strict(), so a body carrying it is a 400 (Constitution rules 1 and 8).
  businessDate DateTime @map("business_date") @db.Date

  // Snapshot of what the distance was measured against (research.md §4).
  shopLatitude          Decimal? @map("shop_latitude") @db.Decimal(9, 6)
  shopLongitude         Decimal? @map("shop_longitude") @db.Decimal(9, 6)
  effectiveRadiusMeters Int      @map("effective_radius_meters")

  // Server-computed, always. Never accepted from a client (CLAUDE.md rule 1).
  distanceMeters Int          @map("distance_meters")
  isExceedRange  Boolean      @map("is_exceed_range")
  flags          VisitFlag[]
  reviewStatus   ReviewStatus @default(NOT_REQUIRED) @map("review_status")

  order Order?

  createdAt DateTime @default(now()) @map("created_at")

  // LOAD-BEARING: makes "exactly one outcome per stop" (FR-006) a database
  // fact rather than a check two concurrent submissions could both pass. A
  // manager-granted revisit produces a NEW stop, so it never contends here.
  @@unique([stopId])
  @@index([companyId, shopId, receivedAt])
  // 008-my-visits: "this executive's visits, newest first" — every query the
  // My visits screen makes. None of the three indexes around it covers that:
  // they serve the shop's history, the day's visits and the review queue.
  //
  // The explicit `map:` is REQUIRED, not cosmetic. Prisma's generated name
  // would be
  // `visits_company_id_executive_id_business_date_submitted_at_id_idx` — 64
  // characters against Postgres' 63-byte identifier limit, which Postgres
  // truncates silently. A hand-written migration and a later `migrate diff`
  // would then disagree about the name and the next `migrate dev` would try
  // to create a second, near-identical index. The longest name otherwise in
  // this schema is 59 characters, so this is the first one to cross.
  @@index([companyId, executiveId, businessDate, submittedAt, id], map: "visits_exec_history_idx")
  @@index([companyId, assignmentId])
  @@index([companyId, reviewStatus])
  @@map("visits")
}

// The commercial result of an order outcome. Exists only as part of its
// visit — the two are created in one transaction, so a visit whose order is
// missing is unrepresentable (FR-027).
model Order {
  id        String @id @default(uuid())
  companyId String @map("company_id")

  visitId String @unique @map("visit_id")
  visit   Visit  @relation(fields: [visitId], references: [id], onDelete: Cascade)

  shopId String @map("shop_id")
  shop   Shop   @relation(fields: [shopId], references: [id])

  // Server-derived from the submitted lines — a client cannot assert a total
  // that disagrees with its own lines. Stored rather than counted on read
  // because the manager's list and the reports sort and filter on them.
  totalQuantity Int @map("total_quantity")
  brandCount    Int @map("brand_count")

  // Written here; moved to DELIVERED by the manager slice — which is
  // 010-manager-app, and these two columns are its attribution (FR-023).
  deliveryStatus DeliveryStatus @default(TO_DELIVER) @map("delivery_status")
  deliveredAt    DateTime?      @map("delivered_at")
  deliveredBy    String?        @map("delivered_by")

  lines OrderLine[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([companyId, shopId])
  @@index([companyId, deliveryStatus])
  @@map("orders")
}

model OrderLine {
  id        String @id @default(uuid())
  companyId String @map("company_id")

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  brandId    String @map("brand_id")
  brand      Brand  @relation(fields: [brandId], references: [id])
  // Snapshot (Architecture §9's "snapshots everywhere") — a brand renamed or
  // retired later never rewrites a recorded order.
  brandLabel String @map("brand_label")

  quantity Int

  // The database-level backstop for FR-012, so the same brand cannot appear
  // twice on one order even under a retry.
  @@unique([orderId, brandId])
  @@index([companyId, brandId])
  @@map("order_lines")
}

// 010-manager-app (data-model.md). Taken from 03-ARCHITECTURE.md:669.
//
// APPEND-ONLY BY CONSTRUCTION. An amendment INSERTS a row at version + 1 and
// flips the previous row's isActive — it never UPDATEs a status, a time or a
// flag (Constitution rule 4, FR-037). Including `version` in the unique key
// is what makes that a database fact rather than a convention: a second
// writer cannot reuse a version, so two managers amending the same session
// at once produce one winner and one P2002, never a lost update.
model Attendance {
  id        String @id @default(uuid())
  companyId String @map("company_id")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  // The company-LOCAL calendar date, from CompanyClock — never a device
  // date. @db.Date so it carries no time component.
  businessDate DateTime          @map("business_date") @db.Date
  session      AttendanceSession
  status       AttendanceStatus

  // Required when PRESENT, null otherwise — enforced in the schema contract
  // and again in the service.
  actualTime DateTime? @map("actual_time")

  // Both SERVER-DERIVED, both absent from the request schema. See
  // LatenessFlag above, and CompanySettings.payableUnitByStatus.
  latenessFlag LatenessFlag? @map("lateness_flag")
  payableUnits Decimal       @map("payable_units") @db.Decimal(4, 2)

  version        Int     @default(1)
  isActive       Boolean @default(true) @map("is_active")
  supersededById String? @map("superseded_by_id")
  // Required on an amendment, null on a first record (FR-037).
  changeReason   String? @map("change_reason")

  recordedBy String   @map("recorded_by")
  recordedAt DateTime @default(now()) @map("recorded_at")

  // LOAD-BEARING: `version` in the key is what makes the history
  // append-only. See the note above the model.
  @@unique([companyId, userId, businessDate, session, version])
  @@index([companyId, businessDate, session, isActive])
  @@index([companyId, userId, businessDate])
  @@map("attendance")
}
