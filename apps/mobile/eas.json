{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "COMPANY_CODE": "DEV",
        "COMPANY_NAME": "Field Sales (Dev)",
        "API_URL": "http://localhost:3000",
        "GOOGLE_MAPS_API_KEY": ""
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "COMPANY_CODE": "SRT",
        "COMPANY_NAME": "Sri Ramana Traders",
        "API_URL": "https://api-staging.example.com",
        "GOOGLE_MAPS_API_KEY": ""
      }
    },
    "production": {
      "env": {
        "COMPANY_CODE": "SRT",
        "COMPANY_NAME": "Sri Ramana Traders",
        "API_URL": "https://api.example.com",
        "GOOGLE_MAPS_API_KEY": ""
      }
    }
  },
  "submit": {
    "production": {}
  }
}
