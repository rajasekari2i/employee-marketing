{
  "extends": "@field-sales/config/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-native",
    "customConditions": ["react-native"],
    "allowSyntheticDefaultImports": true,
    // react-native's own package.json exports map mixes case in a way that trips
    // forceConsistentCasingInFileNames on some platforms; @react-native/typescript-config
    // disables it for the same reason.
    "forceConsistentCasingInFileNames": false
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "node_modules",
    "android",
    "ios",
    "babel.config.js",
    "metro.config.js",
    "eslint.config.mjs"
  ]
}
