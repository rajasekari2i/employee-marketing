# One of these per company build flavor: copy to .env.<flavor> (e.g. .env.dev,
# .env.srt — see android/app/build.gradle's productFlavors) and fill in real
# values. Read natively via react-native-config (android/app/build.gradle's
# dotenv.gradle wiring) and surfaced to JS by src/config.ts.
#
# APP_NAME also backs the Android launcher label (android:label in
# AndroidManifest.xml references @string/APP_NAME, generated from this file).

APP_NAME="Field Sales (Dev)"
COMPANY_CODE="SRK"
COMPANY_NAME="Field Sales (Dev)"
API_URL="http://localhost:3000/api/v1"
GOOGLE_MAPS_API_KEY=""
