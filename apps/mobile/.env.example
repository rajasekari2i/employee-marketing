# One of these per company build flavor: copy to .env.<flavor> (e.g. .env.dev,
# .env.srt — see android/app/build.gradle's productFlavors) and fill in real
# values. Read natively via react-native-config (android/app/build.gradle's
# dotenv.gradle wiring) and surfaced to JS by src/config.ts.
#
# APP_NAME also backs the Android launcher label (android:label in
# AndroidManifest.xml references @string/APP_NAME, generated from this file).

APP_NAME="Field Sales (Dev)"
COMPANY_CODE="SRK"
COMPANY_NAME="Field Sales (Dev)"
# The API's base URL. The `/api/v1` suffix is REQUIRED and is parsed, not
# just concatenated: src/api/client.ts appends paths onto this verbatim and
# adds no prefix of its own, and its resolveFileUrl() strips exactly that
# suffix back off to recover the origin for photo URLs (the API signs those
# as `/api/v1/files/...`, relative to its own origin).
# Baked into the APK at build time by dotenv.gradle, so pointing a flavor at
# a different API means rebuilding that flavor, not just redeploying.
#
#   .env.dev  localhost (below). On a physical device this must be the host
#             machine's LAN IP, not localhost — that resolves to the phone.
#   .env.srt  https://employee-marketing-production.up.railway.app/api/v1
#             Railway's own domain, which is the live one. A custom domain
#             (api.sriramanatraders.in) was set up in Railway but is not in
#             use: the .in registry still returns NXDOMAIN for it. Switching
#             to it later means editing .env.srt and REBUILDING the APK —
#             this value is frozen into the binary at build time.
API_URL="http://localhost:3000/api/v1"
GOOGLE_MAPS_API_KEY=""
