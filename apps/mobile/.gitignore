# dependencies
node_modules/

# Android/Gradle — "**/" so these match at any nesting depth (app/, app/src/..., etc.),
# not just directly under android/. A first pass used android/.cxx/ (no **/), which only
# matches .cxx as a direct child of android/ — the real path is android/app/.cxx/, so it
# silently let ~300 CMake build-intermediate files into a commit before this was caught.
**/android/.gradle/
**/android/**/build/
**/android/local.properties
**/android/**/.cxx/
**/android/.kotlin/
*.keystore
!debug.keystore
# Release signing material. The build reads the keystore path and passwords
# from the environment or ~/.gradle/gradle.properties (android/app/build.gradle),
# so none of this should ever be inside a checkout — these patterns are the
# backstop for when someone drops one here anyway. The root .gitignore's
# `apps/mobile/*.jks` only matches the mobile root, not android/app/.
*.jks
keystore.properties
signing.properties

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# No iOS/ios project is generated on this machine (Architecture §16.1) — kept out of the
# repo on purpose, not an oversight.
/ios
